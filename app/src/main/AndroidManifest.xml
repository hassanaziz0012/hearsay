<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PhoneServer: the PC connects to the phone over the local network. Android 17 also
         asks the user for ACCESS_LOCAL_NETWORK (HomeActivity requests it). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- The keyboards, so setup without adb can check that the one with Rambler is enabled
         and may use the mic (PhoneServer's "keyboards" request). -->
    <queries>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- Status, paired computers, and pairing. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Launched by Session (in KeyPressService). Exported for `hearsay diagnose`, which
             opens it with adb's `am start`. singleTask so a relaunch reuses the
             same field (onNewIntent) instead of stacking activities. -->
        <activity
            android:name=".DictateActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <!-- Presses the keyboard's mic key for the PC side. Enabled in Settings >
             Accessibility (or by setup over adb). -->
        <service
            android:name=".KeyPressService"
            android:exported="false"
            android:label="@string/key_press_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_press_service" />
        </service>
    </application>
</manifest>
