#!/usr/bin/env python3
# Tray indicator for rambler-pc. Shows what the last press is doing (read from the status
# file rambler-pc writes) and runs rambler-pc from its menu. Needs the AppIndicator GNOME
# extension. Middle-click the icon to start/stop.
import os
import subprocess
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import AyatanaAppIndicator3 as AI, Gio, GLib, Gtk  # noqa: E402

HERE = os.path.dirname(os.path.realpath(__file__))
SCRIPT = os.path.join(HERE, "rambler-pc")
RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
STATUS = os.path.join(RUN, "rambler-pc.status")  # "state<TAB>message", written by rambler-pc
ERROR_ICON_SECS = 10  # a plain error goes back to the idle icon after this
BUSY_STALE_SECS = 30  # "busy" this old means rambler-pc died mid-press

# state: (icon, label, toggle item label or None to disable it, cancel shown)
STATES = {
    "idle": ("audio-input-microphone-symbolic", "Ready", "Start dictation", False),
    "busy": ("content-loading-symbolic", "Working…", None, False),
    "listening": ("rambler-pc-listening", "Listening", "Stop and paste", True),
    "error": ("dialog-warning-symbolic", "Error", "Start dictation", False),
    # The phone was unreachable; the next press finishes the job (see rambler-pc).
    "retry": ("dialog-warning-symbolic", "Reconnect the phone", "Finish (press again)", False),
}


class Tray:
    def __init__(self):
        self.ind = AI.Indicator.new("rambler-pc", STATES["idle"][0], AI.IndicatorCategory.APPLICATION_STATUS)
        self.ind.set_icon_theme_path(os.path.join(HERE, "icons"))
        self.ind.set_title("Rambler PC")
        self.ind.set_status(AI.IndicatorStatus.ACTIVE)

        menu = Gtk.Menu()
        self.label = Gtk.MenuItem(label="Ready", sensitive=False)
        self.detail = Gtk.MenuItem(sensitive=False)
        self.toggle = Gtk.MenuItem(label="Start dictation")
        self.toggle.connect("activate", lambda _: self.run("toggle"))
        self.cancel = Gtk.MenuItem(label="Cancel")
        self.cancel.connect("activate", lambda _: self.run("cancel"))
        quit_ = Gtk.MenuItem(label="Quit tray")
        quit_.connect("activate", lambda _: Gtk.main_quit())
        for item in (self.label, self.detail, Gtk.SeparatorMenuItem(), self.toggle, self.cancel,
                     Gtk.SeparatorMenuItem(), quit_):
            menu.append(item)
        menu.show_all()
        self.ind.set_menu(menu)
        self.ind.set_secondary_activate_target(self.toggle)

        self.error_timer = 0
        # rambler-pc replaces the file with mv, so watch the directory entry, not the inode.
        self.monitor = Gio.File.new_for_path(STATUS).monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", lambda *_: self.refresh())
        GLib.timeout_add_seconds(BUSY_STALE_SECS, self.refresh_stale)
        self.refresh()

    def run(self, cmd):
        # No terminal, so rambler-pc logs to $XDG_RUNTIME_DIR/rambler-pc.log.
        subprocess.Popen([SCRIPT, cmd], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)

    def read(self):
        try:
            with open(STATUS) as f:
                state, _, msg = f.read().rstrip("\n").partition("\t")
            age = time.time() - os.path.getmtime(STATUS)
        except OSError:
            return "idle", "", 0
        if state not in STATES or (state == "busy" and age > BUSY_STALE_SECS):
            return "idle", "", age
        return state, msg, age

    def refresh_stale(self):
        self.refresh()
        return True

    def refresh(self):
        state, msg, age = self.read()
        if self.error_timer:
            GLib.source_remove(self.error_timer)
            self.error_timer = 0
        if state == "error":
            left = ERROR_ICON_SECS - age
            if left > 0:
                self.error_timer = GLib.timeout_add(int(left * 1000), self.clear_error)
            else:
                state = "idle"
                msg = "Last error: " + msg
        self.show(state, msg)

    def clear_error(self):
        self.error_timer = 0
        _, msg, _ = self.read()
        self.show("idle", "Last error: " + msg)
        return False

    def show(self, state, msg):
        icon, label, toggle, cancel = STATES[state]
        if state == "busy" and msg:  # "Starting…" / "Finishing…"
            label, msg = msg, ""
        self.ind.set_icon_full(icon, label)
        self.label.set_label(label)
        self.detail.set_label(msg)
        self.detail.set_visible(bool(msg))
        self.toggle.set_label(toggle or "Start dictation")
        self.toggle.set_sensitive(toggle is not None)
        self.cancel.set_visible(cancel)


if __name__ == "__main__":
    Tray()
    Gtk.main()
