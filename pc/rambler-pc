#!/usr/bin/env bash
# rambler-pc: dictate on the phone with Rambler (Pixelboard), paste on the PC.
#
#   rambler-pc            toggle: first call starts listening, second stops and pastes
#   rambler-pc start|stop force one half of the toggle
#   rambler-pc cancel     close Rambler without pasting
#   rambler-pc calibrate  find the mic key's position on the phone and save it
#
# Env: ADB_SERIAL (pick a device), RAMBLER_PASTE=0 (print/copy only, no Ctrl+V),
#      RAMBLER_DEBUG=1 (timings on stderr).

set -uo pipefail

# Run from a GNOME shortcut there's no terminal: make sure adb is found and keep a log.
PATH=$PATH:/opt/android-sdk/platform-tools
[[ -t 2 ]] || { exec 2>>"${XDG_RUNTIME_DIR:-/tmp}/rambler-pc.log"; RAMBLER_DEBUG=1; echo "--- $(date '+%F %T') ${1:-toggle}" >&2; }

PKG=me.hassandev.hearsay
ACTIVITY=$PKG/.DictateActivity
STATE=${XDG_RUNTIME_DIR:-/tmp}/rambler-pc.state
CONF_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/rambler-pc
MIC_CONF=$CONF_DIR/mic

# The keyboard that has Rambler (IME component). Pixelboard by default; another Gboard
# build (e.g. stock Gboard with Rambler) goes in $CONF_DIR/keyboard.
TARGET=com.akshaykadam.pixelboard/com.android.inputmethod.latin.LatinIME
[[ -f $CONF_DIR/keyboard ]] && read -r TARGET < "$CONF_DIR/keyboard"

SETTLE_MS=700        # text must stay unchanged this long after stopping
SETTLE_TIMEOUT_MS=8000

# Mic key center ("Use voice typing" / "Insert text" while listening), used only when the
# app's accessibility service can't press it. There is no default (it would tap random
# keys on other phones): `rambler-pc calibrate` saves it.
MIC_X= MIC_Y=
[[ -f $MIC_CONF ]] && read -r MIC_X MIC_Y < "$MIC_CONF"

a() { timeout "${ADB_TIMEOUT:-8}" adb ${ADB_SERIAL:+-s "$ADB_SERIAL"} "$@"; }
sh_() { a shell "$@" | tr -d '\r'; }
now_ms() { date +%s%3N; }
T0=$(now_ms)
log() { [[ ${RAMBLER_DEBUG:-0} == 1 ]] && echo "[$(( $(now_ms) - T0 ))ms] $*" >&2; return 0; }
# One notification, updated in place across presses (each press is a new process, so its id
# lives in a file). Status updates are transient so they stay out of the notification list;
# errors (third argument "keep") stay there.
NOTIFY_ID=${XDG_RUNTIME_DIR:-/tmp}/rambler-pc.notify-id
notify() {
    local id=0 opts=(-e)
    [[ -f $NOTIFY_ID ]] && read -r id < "$NOTIFY_ID"
    [[ ${3:-} == keep ]] && opts=()
    id=$(notify-send -a "Hearsay" -t "${2:-2000}" "${opts[@]}" -p -r "${id:-0}" \
        "Hearsay" "$1" 2>/dev/null) && echo "$id" > "$NOTIFY_ID"
    return 0
}
# For pc/rambler-pc-tray: "idle", "busy", "listening", "error", or "retry" (an error the
# next press recovers from, i.e. the state file is still there), a tab, and a message.
TRAY=${XDG_RUNTIME_DIR:-/tmp}/rambler-pc.status
tray() { printf '%s\t%s\n' "$1" "${2:-}" > "$TRAY.tmp" && mv -f "$TRAY.tmp" "$TRAY"; }
die() {
    echo "rambler-pc: $*" >&2; notify "Error: $*" 5000 keep
    if [[ -f $STATE ]]; then tray retry "$*"; else tray error "$*"; fi
    exit 1
}

connected() { [[ $(ADB_TIMEOUT=3 a get-state 2>/dev/null) == device ]]; }

require_device() {
    connected && return
    # Wireless adb usually comes back by itself within a few seconds (mDNS).
    log "not connected, waiting"
    ADB_TIMEOUT=4 a wait-for-device 2>/dev/null
    connected && return
    [[ -f $STATE ]] && die "phone not connected over adb. Reconnect, then press again"
    die "phone not connected over adb"
}

# The scripts below run on the phone in one `adb shell` each, so their polling loops cost
# no adb round trips. They exit 0 on success and 10-19 for their own failures; anything
# else is adb (or `timeout`) failing. This prelude gives them some helpers.
PHONE_LIB='
# mksh arithmetic is 32-bit (with defined wraparound), so keep times relative to the start.
T=$(date +%s%3N)
now() { echo $(( $(date +%s%3N) - T )); }
dbg() { [ "$D" = 1 ] && echo "  phone +$(now)ms $*" >&2; return 0; }
listening() { dumpsys audio 2>/dev/null | grep -q "client=VOICE_RECOGNITION.*pack:${IME%%/*}"; }
# press <mic|close> via the app'"'"'s accessibility service: 1 pressed, 2 key not on
# screen, 0 service off.
press() { r=$(am broadcast -a $PKG.PRESS -p $PKG --es key "$1" --es ime "${IME%%/*}"); r=${r##*result=}; echo "${r%%[!0-9]*}"; }
# out <status|text>: the app output (see OutReceiver), text as base64.
out() {
    r=$(am broadcast -a $PKG.OUT -p $PKG --es what "$1")
    case $r in *result=1*) ;; *) return 1;; esac
    r=${r#*data=\"}; echo "${r%\"*}"
}
# Tap at the calibrated mic position; fails if there is none.
tap_mic() { [ -n "$X" ] && input tap $X $Y; }
# Android 17 has mInputShown + mIsInputViewShown; older versions may lack the second one,
# so only a field that is present and false counts against it.
kbd_shown() {
    d=$(dumpsys input_method 2>/dev/null)
    case $d in *mInputShown=true*) ;; *) return 1;; esac
    case $d in *mIsInputViewShown=false*) case $d in *mIsInputViewShown=true*) ;; *) return 1;; esac;; esac
    return 0
}
'

# phone <script> [VAR=value...]: runs <script> on the phone with the given variables set.
phone() {
    local script=$1; shift
    local vars="IME=$TARGET PKG=$PKG ACT=$ACTIVITY X=$MIC_X Y=$MIC_Y D=${RAMBLER_DEBUG:-0}"
    (( $# )) && vars+=" $*"
    a shell "$vars; $PHONE_LIB$script"
}

# Reports an adb failure (exit code $1 of `phone`) and exits. The state file is left alone,
# so the next press can finish the job once the phone is back.
adb_failed() {
    if (( $1 >= 10 && $1 < 20 )) && connected; then return 1; fi
    die "${2:-phone disconnected}. Reconnect, then press again"
}

START_PHONE='
input keyevent KEYCODE_WAKEUP
# Only switch keyboards if the target is not already the current one (PREV is empty then).
[ -z "$PREV" ] || ime set $IME >/dev/null || exit 10
am start -n $ACT --ez clear true >/dev/null 2>&1 || exit 10
dbg "field open"
# Press the mic key once the keyboard is up: by resource id through the service, else at
# the calibrated coordinates. Also fall back if the service is on but still cannot see the
# key a second after the keyboard is up (seen once right after enabling it).
end=$(( $(now) + 4000 )); shown_at=
until listening; do
    r=$(press mic)
    [ "$r" = 1 ] && { dbg "pressed mic (service)"; break; }
    [ "$r" = 0 ] && [ -z "$X" ] && exit 13
    if kbd_shown; then
        [ -z "$shown_at" ] && shown_at=$(now)
        if [ -n "$X" ] && { [ "$r" = 0 ] || [ $(( $(now) - shown_at )) -gt 1000 ]; }; then
            [ "$r" = 0 ] && sleep 0.3 # let the keyboard finish laying out
            tap_mic; dbg "tapped mic at $X,$Y (service result $r)"; break
        fi
    fi
    [ $(now) -gt $end ] && exit 11
    sleep 0.1
done
# If the press was lost (Rambler not recording 2 s later), press once more.
retry=$(( $(now) + 2000 )); end=$(( $(now) + 4500 ))
until listening; do
    if [ -n "$retry" ] && [ $(now) -gt $retry ]; then
        retry=; r=$(press mic)
        [ "$r" = 1 ] || tap_mic
        dbg "pressed mic again (service result $r)"
    fi
    [ $(now) -gt $end ] && exit 12
    sleep 0.1
done
'

# Stops Rambler (KEY=mic inserts the text, KEY=close discards it), then for KEY=mic waits
# until the field has text that has stopped changing (Rambler may rewrite it) and prints it.
STOP_PHONE='
# Rambler may already have stopped on its own; pressing then would start a new session.
if listening; then
    r=$(press $KEY)
    if [ "$r" = 1 ]; then dbg "pressed $KEY (service)"
    elif tap_mic; then dbg "tapped mic at $X,$Y"
    else dbg "could not press $KEY (service result $r)"; fi
fi
[ $KEY = mic ] || exit 0
end=$(( $(now) + TIMEOUT )); last=; since=$(now)
while [ $(now) -lt $end ]; do
    cur=$(out status)
    t=$(now)
    if [ "$cur" != "$last" ]; then
        last=$cur; since=$t; dbg "changed: $cur"
    elif [ -n "$cur" ] && [ "${cur##* }" != 0 ] && [ $(( t - since )) -ge $SETTLE ] && ! listening; then
        break
    fi
    sleep 0.05
done
t=$(out text) || exit 10
printf %s "$t" | base64 -d
'

RESTORE_PHONE='
am start -n $ACT --ez clear true >/dev/null 2>&1
input keyevent KEYCODE_HOME
[ -n "$PREV" ] && [ "$PREV" != null ] && ime set "$PREV" >/dev/null
if [ "$AWAKE" = 0 ]; then input keyevent KEYCODE_SLEEP; fi
'

# State file: line 1 previous IME, line 2 whether the screen was awake (1/0), line 3
# "starting" or "listening".
read_state() { { read -r PREV; read -r WAS_AWAKE; read -r PHASE; } < "$STATE"; }

# Clears the field and restores the keyboard and screen state the state file recorded.
# Safe to call twice. Keeps the state file if the phone is unreachable.
restore() {
    [[ -f $STATE ]] || return 0
    local PREV WAS_AWAKE PHASE; read_state
    connected || { log "restore skipped, phone unreachable"; return 1; }
    phone "$RESTORE_PHONE" "PREV=$PREV" "AWAKE=$WAS_AWAKE" || return 1
    rm -f "$STATE"
    log "restored ime=$PREV"
}

start() {
    tray busy "Starting…"
    require_device
    local info prev was_awake rc
    info=$(sh_ 'settings get secure default_input_method; dumpsys power 2>/dev/null | grep -q mWakefulness=Awake && echo 1 || echo 0') ||
        die "couldn't read the phone's state"
    { read -r prev; read -r was_awake; } <<<"$info"
    # Already on the target keyboard (Rambler in stock Gboard, or a previous run died before
    # restoring): there is nothing to switch to or back from.
    [[ $prev == "$TARGET" ]] && prev=
    printf '%s\n%s\nstarting\n' "$prev" "$was_awake" > "$STATE"
    log "prev ime=$prev awake=$was_awake"

    phone "$START_PHONE" "PREV=$prev"; rc=$?
    if (( rc != 0 )); then
        adb_failed "$rc" "phone disconnected while starting"
        restore
        case $rc in
            10) die "couldn't open the dictation field" ;;
            11) die "the keyboard didn't come up" ;;
            13) die "the Hearsay key presser is off. Turn it on in the phone's Accessibility settings" ;;
            *) die "Rambler didn't start listening" ;;
        esac
    fi
    sed -i 3s/.*/listening/ "$STATE"
    log "listening"
    tray listening
    notify "Listening… press again to paste"
}

stop() {
    local paste=${1:-1}
    [[ -f $STATE ]] || die "not listening"
    tray busy "$([[ $paste == 1 ]] && echo Finishing… || echo Cancelling…)"
    require_device
    local PREV WAS_AWAKE PHASE; read_state
    if [[ $PHASE != listening ]]; then
        # An earlier start was cut off (adb dropped); just put the phone back.
        restore || die "phone disconnected before it was restored. Reconnect, then press again"
        tray idle "Phone restored"; notify "Phone restored"; return
    fi
    local key=mic; [[ $paste == 0 ]] && key=close

    [[ $paste == 1 ]] && notify "Finishing…"
    local text rc
    text=$(ADB_TIMEOUT=$(( SETTLE_TIMEOUT_MS / 1000 + 6 )) phone "$STOP_PHONE" \
        "KEY=$key" "SETTLE=$SETTLE_MS" "TIMEOUT=$SETTLE_TIMEOUT_MS"); rc=$?
    (( rc == 0 )) || adb_failed "$rc" || { restore; die "couldn't read text from phone"; }
    log "got ${#text} chars"

    # Paste before tidying up the phone; restore takes ~0.8 s and nothing on the PC waits on it.
    if [[ $paste == 0 ]]; then
        notify "Cancelled"
    elif [[ -z ${text//[[:space:]]/} ]]; then
        notify "Nothing heard"
    else
        printf '%s\n' "$text"
        paste_text "$text"
        log "pasted"
    fi
    restore || die "phone disconnected before it was restored. Reconnect, then press again"
    tray idle
}

paste_text() {
    command -v wl-copy >/dev/null || { notify "Done (wl-copy missing, text printed only)"; return; }
    printf '%s' "$1" | wl-copy
    if [[ ${RAMBLER_PASTE:-1} == 1 ]] && command -v ydotool >/dev/null; then
        sleep 0.05
        ydotool key 29:1 47:1 47:0 29:0 >/dev/null 2>&1 && { notify "Pasted"; return; }
    fi
    notify "Copied to clipboard"
}

# Only needed while the accessibility service is off.
calibrate() {
    require_device
    local prev; prev=$(sh_ settings get secure default_input_method)
    [[ $prev == "$TARGET" ]] && prev=
    printf '%s\n1\ncalibrating\n' "$prev" > "$STATE"
    trap restore EXIT
    phone '
input keyevent KEYCODE_WAKEUP
ime set $IME >/dev/null && am start -n $ACT --ez clear true >/dev/null 2>&1 || exit 10
end=$(( $(now) + 4000 ))
until kbd_shown; do [ $(now) -gt $end ] && exit 11; sleep 0.1; done
sleep 0.3' || die "keyboard didn't come up"
    echo "dumping UI (takes a few seconds)…"
    a shell uiautomator dump --windows /sdcard/rambler-ui.xml >/dev/null
    local id_prefix=${TARGET%%/*}:id/
    local bounds
    bounds=$(a exec-out cat /sdcard/rambler-ui.xml | grep -o "resource-id=\"${id_prefix}key_pos_header_power_key\"[^>]*bounds=\"[^\"]*\"" | grep -o 'bounds="[^"]*"' | head -1)
    a shell rm -f /sdcard/rambler-ui.xml
    [[ $bounds =~ \[([0-9]+),([0-9]+)\]\[([0-9]+),([0-9]+)\] ]] || die "mic key not found"
    MIC_X=$(( (BASH_REMATCH[1] + BASH_REMATCH[3]) / 2 ))
    MIC_Y=$(( (BASH_REMATCH[2] + BASH_REMATCH[4]) / 2 ))
    mkdir -p "$CONF_DIR"
    echo "$MIC_X $MIC_Y" > "$MIC_CONF"
    echo "mic key at $MIC_X,$MIC_Y (saved to $MIC_CONF)"
}

case ${1:-toggle} in
    toggle) if [[ -f $STATE ]]; then stop; else start; fi ;;
    start) start ;;
    stop) stop ;;
    cancel) stop 0 ;;
    calibrate) calibrate ;;
    *) sed -n '2,10p' "$0"; exit 2 ;;
esac
